# ══════════════════════════════════════════════════════════
#  YTtoTg — YouTube → Telegram Backup Bot
#  Copy this file to `.env` and fill in your values.
# ══════════════════════════════════════════════════════════

# ── Telegram (required) ────────────────────────────────────
# Get API_ID / API_HASH from https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here
# Bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
# Your Telegram user ID (get from @userinfobot)
OWNER_ID=123456789
# Where videos are uploaded (channel/group chat id, e.g. -1001234567890)
DEST_CHAT_ID=-1001234567890

# ── Downloads ──────────────────────────────────────────────
# Parallel download workers (1-5)
PARALLEL_DOWNLOADS=3
# best | 1080 | 720 | 480 | audio
DEFAULT_QUALITY=best
# Dashboard edit interval in seconds (3-15)
PROGRESS_INTERVAL=3
# Retry attempts per failed video
MAX_RETRIES=3

# ── YouTube anti-bot (recommended) ─────────────────────────
# Export cookies.txt from your browser and place it in data/
# (or upload it in Telegram with /cookies)
COOKIES_PATH=
# Optional PO-Token for heavy bot-detection
PO_TOKEN=
# Sleep between requests (seconds)
SLEEP_INTERVAL=3
MAX_SLEEP_INTERVAL=8
# Max downloads per hour (0 = unlimited)
RATE_LIMIT=0

# ── Storage ────────────────────────────────────────────────
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
MAX_DISK_GB=10
DISK_SAFETY_MARGIN_GB=1.5
DISK_ALERT_PERCENT=85

# ── Upload / split ─────────────────────────────────────────
SPLIT_SIZE_MB=1900
TG_MAX_UPLOAD_MB=1990

# ── Daily report ───────────────────────────────────────────
DAILY_REPORT=true
DAILY_REPORT_HOUR=22

# ── Auto-watch (new upload detection) ──────────────────────
# How often watched channels are checked for new videos (minutes, 5-1440)
WATCH_INTERVAL_MIN=30

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/

# ── Secrets & credentials (NEVER commit these) ─────────
.env
.env.*
!.env.example
*.session
*.session-journal

# ── Runtime data (regenerated by the bot) ──────────────
# Keep the safe setup guide visible, but never track cookies, state or logs.
ytbot/data/*
!ytbot/data/README.md
downloads/
ytbot/downloads/
*.log
*.tmp
*.part
*.ytdl

# ── OS junk ─────────────────────────────────────────────
.DS_Store
Thumbs.db

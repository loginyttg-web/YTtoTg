{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["python"],
      "phases": {
        "install": {
          "cmds": ["pip install -r ytbot/requirements.txt"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "python3.11 ytbot/main.py",
    "restartPolicyType": "ALWAYS"
  }
}
